GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_COOKIE_SECRET=

# Fuente de teselas del mapa (SC-03 y SC-04). Por defecto OpenStreetMap.
# La Tile Usage Policy de OSM prohíbe el uso intensivo: sustituir antes de producción.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# Nombre del proveedor tal y como lo nombran los textos legales (RGPD art. 13.1.e).
NEXT_PUBLIC_MAP_PROVIDER_NAME=OpenStreetMap

# Ficha del titular del sitio (LSSI-CE art. 10). Aparece literalmente en el aviso legal y en la
# política de privacidad, así que hay que rellenarla antes de publicar. Ver .claude/docs/LEGAL.md.
#
# NO se versionan: van en .env, que .gitignore excluye. Sin ellas, las páginas legales muestran
# marcadores «[PENDIENTE: …]» y `npm run check:legal` falla.
LEGAL_HOLDER=[PENDIENTE: nombre o razón social del titular]
LEGAL_TAX_ID=[PENDIENTE: NIF]
LEGAL_ADDRESS=[PENDIENTE: domicilio completo]
LEGAL_EMAIL=[PENDIENTE: correo de contacto]

# Delegado de protección de datos. Opcional: a esta escala el art. 37 del RGPD no lo exige.
# LEGAL_DPO=
